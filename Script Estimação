-- PESO
--==================================================

local function getWeight(pet)

	if not pet then
		return 0
	end

	local weight =
		pet.Weight

	if type(weight) == "number" then
		return weight
	end

	if type(weight) == "string" then

		local clean =
			weight:gsub(
				"[^%d%.%-]",
				""
			)

		local n =
			tonumber(clean)

		if n then
			return n
		end

	end

	-- tenta atributos
	local attr =
		pet:GetAttribute("PetWeight")

	if type(attr) == "number" then
		return attr
	end

	if type(attr) == "string" then

		local n =
			tonumber(
				attr:gsub(
					"[^%d%.%-]",
					""
				)
			)

		if n then
			return n
		end

	end

	return 0

end

--==================================================
-- PODE FUNDIR
--==================================================

local function podeFundir(pet)

	if not pet then
		return false
	end

	if not pet.UUID then
		return false
	end

	local uuid =
		tostring(pet.UUID)

	if fusionCooldown[uuid] then
		return false
	end

	local weight =
		getWeight(pet)

	-- 1 KG PROTEGIDO
	if weight == PROTECTED_WEIGHT then
		return false
	end

	-- 50.000 KG OU MAIS PROTEGIDO
	if weight >= MAX_FUSION_WEIGHT then
		return false
	end

	return true

end

--==================================================
-- PATCH INVENTÁRIO
--==================================================

local function processPetPatch(patch)

	if type(patch) ~= "table" then
		return
	end

	local path =
		patch.Path

	if type(path) ~= "table" then
		return
	end

	if path[1] ~= "PetsBackpack" then
		return
	end

	local uuid =
		path[2]

	if not uuid then
		return
	end

	uuid =
		tostring(uuid)

	if patch.Delete == true then

		inventoryPets[uuid] = nil
		fusionCooldown[uuid] = nil

		return

	end

	local value =
		patch.Value

	if type(value) == "table"
	and value.Name then

		inventoryPets[uuid] = {

			UUID = uuid,

			Name =
				tostring(value.Name),

			Type =
				value.Type
				and tostring(value.Type)
				or "Default",

			Weight =
				value.Weight

		}

		fusionCooldown[uuid] = nil

	end

end

