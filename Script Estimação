local function variant(t)

	t =
		tostring(
			t or "Default"
		)

	if t == "Default"
	or t == "Normal" then

		return "Normal"

	elseif t == "Golden"
	or t == "Gold" then

		return "Dourado"

	elseif t == "Diamond" then

		return "Diamante"

	elseif t == "Rainbow" then

		return "Rainbow"

	end

	return t

end

