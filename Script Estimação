		if not inventoryPets[uuid] then

			fusionCooldown[uuid] = nil

		end

	end

end

--==================================================
-- GRUPOS
--==================================================

local function criarGruposFusion()

	local groups = {}

	for uuid,pet in pairs(inventoryPets) do

		if pet
		and pet.Name
		and pet.UUID
		and podeFundir(pet) then

			local nome =
				tostring(pet.Name)

			local tipo =
				tostring(
					pet.Type or "Default"
				)

			local key =
				nome.."|"..tipo

			if not groups[key] then

				groups[key] = {

					Name = nome,

					Type = tipo,

					Pets = {}

				}

			end

			table.insert(
				groups[key].Pets,
				pet
			)

		end

	end

	return groups

end

--==================================================
-- FAZER FUSION
--==================================================

local function fazerFusion(group)

	if not group then
		return false
	end

	if #group.Pets < 3 then
		return false
	end

	local p1 =
		group.Pets[1]

	local p2 =
		group.Pets[2]

	local p3 =
		group.Pets[3]

	if not p1
	or not p2
	or not p3 then

		return false

	end

	if not podeFundir(p1)
	or not podeFundir(p2)
	or not podeFundir(p3) then

		return false

	end

	local uuids = {

		[p1.UUID] = true,
		[p2.UUID] = true,
		[p3.UUID] = true

	}

	fusionCooldown[
		tostring(p1.UUID)
	] = true

	fusionCooldown[
		tostring(p2.UUID)
	] = true

	fusionCooldown[
		tostring(p3.UUID)
	] = true

	local sucesso =
		pcall(function()

			Bridge:FireServer(
				"General",
				"FuseMachine",
				"Fuse",
				group.Name,
				uuids
			)

		end)

	if sucesso then

		fuseStatus.Text =
			"🔥 FUSÃO: "..group.Name

		fuseStatus.TextColor3 =
			Color3.fromRGB(255,100,180)

		return true

	end

	fusionCooldown[
		tostring(p1.UUID)
	] = nil

	fusionCooldown[
		tostring(p2.UUID)
	] = nil

	fusionCooldown[
		tostring(p3.UUID)
	] = nil

	return false

end

--==================================================
-- EXECUTAR FUSION
--==================================================

local function executarFusion()

	if fusionBusy then
		return
	end

	if not autoFuse then
		return
	end

	fusionBusy = true

	while autoFuse do

		limparCooldown()

		local groups =
			criarGruposFusion()

		local fezAlguma = false

		for _,group in pairs(groups) do

			if not autoFuse then
				break
			end

			while #group.Pets >= 3
			and autoFuse do

				local p1 =
					group.Pets[1]

				local p2 =
					group.Pets[2]

				local p3 =
					group.Pets[3]

				if not p1
				or not p2
				or not p3 then

					break

				end

				local ok =
					fazerFusion(group)

				if ok then

					fezAlguma = true

					table.remove(
						group.Pets,
						1
					)

					table.remove(
						group.Pets,
						1
					)

					table.remove(
						group.Pets,
						1
					)

					task.wait(0.35)

				else

					break

				end

			end

		end

		-- IMPORTANTE:
		-- reconstrói os grupos novamente
		-- para pegar pets novos

		if fezAlguma then

			task.wait(0.5)

		else

			task.wait(0.4)

		end

	end

	fusionBusy = false

end

