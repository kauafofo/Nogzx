--==================================================

local function getPrompt(pet)

	for _,obj in ipairs(
		pet:GetDescendants()
	) do

		if obj:IsA("ProximityPrompt") then

			local action =
				string.lower(
					tostring(obj.ActionText or "")
				)

			if action == "buy pet"
			or string.find(
				action,
				"buy",
				1,
				true
			)
			or string.find(
				action,
				"compr",
				1,
				true
			) then

				return obj

			end

		end

	end

	return nil

end

--==================================================
-- RARITY
--==================================================

local function getRarity(pet)

	local texto = ""

	--==============================================
	-- PRIMEIRO: ATTRIBUTES
	--==============================================

	local directAttributes = {
		"Rarity",
		"RarityName",
		"rarity",
		"rarityName"
	}

	for _,attr in ipairs(directAttributes) do

		local value =
			pet:GetAttribute(attr)

		if value ~= nil then

			texto =
				texto.." "..tostring(value)

		end

	end

	--==============================================
	-- DESCENDENTES
	--==============================================

	for _,obj in ipairs(
		pet:GetDescendants()
	) do

		-- Attributes
		for _,attr in ipairs(directAttributes) do

			local value =
				obj:GetAttribute(attr)

			if value ~= nil then

				texto =
					texto.." "..tostring(value)

			end

		end

		-- Textos
		if obj:IsA("TextLabel")
		or obj:IsA("TextButton")
		or obj:IsA("TextBox") then

			local ok,value =
				pcall(function()
					return obj.Text
				end)

			if ok and value then

				texto =
					texto.." "..tostring(value)

			end

		end

	end

	texto =
		string.lower(texto)

	--==============================================
	-- SECRET
	--==============================================

	if string.find(
		texto,
		"secret",
		1,
		true
	)
	or string.find(
		texto,
		"secreto",
		1,
		true
	) then

		return "Secret"

	end

	--==============================================
	-- MYTHIC
	--==============================================

	if string.find(
		texto,
		"mythical",
		1,
		true
	)
	or string.find(
		texto,
		"mythic",
		1,
		true
	)
	or string.find(
		texto,
		"mítico",
		1,
		true
	)
	or string.find(
		texto,
		"mitico",
		1,
		true
	) then

		return "Mythic"

	end

	--==============================================
	-- LEGENDARY
	--==============================================

	if string.find(
		texto,
		"legendary",
		1,
		true
	)
	or string.find(
		texto,
		"lendário",
		1,
		true
	)
	or string.find(
		texto,
		"lendario",
		1,
		true
	) then

		return "Legendary"

	end

	--==============================================
	-- EPIC
	--==============================================

	if string.find(
		texto,
		"epic",
		1,
		true
	)
	or string.find(
		texto,
		"épico",
		1,
		true
	)
	or string.find(
		texto,
		"epico",
		1,
		true
	) then

		return "Epic"

	end

	--==============================================
	-- UNCOMMON
	--==============================================

	if string.find(
		texto,
		"uncommon",
		1,
		true
	)
	or string.find(
		texto,
		"incomum",
		1,
		true
	) then

		return "Uncommon"

	end

	--==============================================
	-- RARE
	--==============================================

	if string.find(
		texto,
		"rare",
		1,
		true
	)
	or string.find(
		texto,
		"raro",
		1,
		true
	) then

		return "Rare"

	end

	--==============================================
	-- COMMON
	--==============================================

	if string.find(
		texto,
		"common",
		1,
		true
	)
	or string.find(
		texto,
		"comum",
		1,
		true
	) then

		return "Common"

	end

	return "Unknown"

end

--==================================================
-- NOME
--==================================================

local function getName(pet,prompt)

	local nomes = {}

	if prompt
	and prompt.ObjectText
	and prompt.ObjectText ~= "" then

		table.insert(
			nomes,
			tostring(prompt.ObjectText)
		)

	end

	local petName =
		pet:GetAttribute("PetName")

	if petName then

		table.insert(
			nomes,
			tostring(petName)
		)

	end

	table.insert(
		nomes,
		tostring(pet.Name)
	)

	for _,nome in ipairs(nomes) do

		nome =
			nome:gsub(
				"%$[%d%.,]+",
				""
			)

		nome =
			nome:gsub(
				"%b()",
				""
			)

		nome =
			nome:gsub(
				"%s+",
				" "
			)

		nome =
			nome:gsub(
				"^%s+",
				""
			)

		nome =
			nome:gsub(
				"%s+$",
				""
			)

		if nome ~= "" then
			return nome
		end

	end

	return tostring(pet.Name)

end

--==================================================
-- NORMALIZAR
--==================================================

local function normalizeName(name)

	return string.lower(
		tostring(name or "")
	):gsub("%s+","")
	:gsub("%-","")
	:gsub("_","")

end

--==================================================
-- COMPRAR
--==================================================

local function buyPet(pet)

	local prompt =
		getPrompt(pet)

	if not prompt then
		return
	end

	local rarity =
		getRarity(pet)

	local name =
		getName(pet,prompt)

	local normalized =
		normalizeName(name)

	--==============================================
	-- SECRET
	--==============================================

	if rarity == "Secret" then

		if not rarities.Secret then
			return
		end

	--==============================================
	-- MYTHIC
	--==============================================

	elseif rarity == "Mythic" then

		if not rarities.Mythic then
			return
		end

	--==============================================
	-- OUTRAS RARIDADES
	--==============================================

	elseif rarity == "Common"
	or rarity == "Uncommon"
	or rarity == "Rare"
	or rarity == "Epic"
	or rarity == "Legendary" then

		if not rarities[rarity] then
			return
		end

	else

		return

	end

	if not prompt.Parent then
		return
	end

	if not prompt.Enabled then
		return
	end

	pcall(function()

		if typeof(fireproximityprompt) ==
			"function" then

			fireproximityprompt(prompt)

		else

			prompt:InputHoldBegin()

			task.wait(
				math.max(
					prompt.HoldDuration,
					0.1
				)
			)

			prompt:InputHoldEnd()

		end

	end)

end

